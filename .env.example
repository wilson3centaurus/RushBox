# Copy to .env.local and fill in. Never commit .env.local.
#
# Values come from the Supabase dashboard: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The publishable (anon) key. Public by design — it ships in the browser
# bundle, and anyone can read it out of devtools. The row-level security
# policies in supabase/migrations/0002_policies.sql are what protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security completely — never prefix with
# NEXT_PUBLIC_, never commit it, never paste it into chat, tickets or docs.
SUPABASE_SERVICE_ROLE_KEY=

# While true the app runs entirely on local mock data and makes no Supabase
# calls, so the UI can be worked on before the backend is wired up.
NEXT_PUBLIC_USE_MOCK_DATA=true
