# Copy to .env.local and fill in. Never commit .env.local.
#
# NOTE: the Supabase URL must be https:// before any deployed (https) frontend
# can talk to it — browsers block plain-http API calls as mixed content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never paste into chat/docs/tickets.
SUPABASE_SERVICE_ROLE_KEY=

# While true the app runs entirely on local mock data and no Supabase calls are made.
NEXT_PUBLIC_USE_MOCK_DATA=true
